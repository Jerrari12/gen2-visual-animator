# Normalize text line endings; let git auto-detect binaries (GLB, PNG, etc.)
* text=auto

# ⚠ GOLDEN FILES ARE COMPARED AS EXACT STRINGS, so they must check out as LF on
# every platform. `* text=auto` above stores them as LF (verified: zero CRLF in
# any golden blob) but checks them out using core.eol, which is NATIVE by
# default - so a fresh clone on Windows gets CRLF while JSON.stringify() emits
# LF, and all ten official-kit tests fail with a full-file diff that reads
# exactly like a real generator regression. Measured: Windows fresh clone
# 57/67, the same clone with core.eol=lf (what a Linux CI runner does) 67/67.
# CI was never affected; a Windows contributor always was.
test/golden/** text eol=lf
*.glb binary
*.png binary
*.jpg binary
*.ico binary

# ⚠ THE REQUIREMENT-SCOPE CONTRACT IS HASH-PINNED across three repos, and the
# pin is computed from the WORKING FILE. Without a fixed line ending a Windows
# checkout gets CRLF, the sha256 changes, and every drift gate fails on a fresh
# clone - a false "someone edited it" that the obvious fix (bump the hash)
# would launder into a real split.
requirement-scope.js text eol=lf

# The tabletop-completion module is hash-pinned the same way (planner source,
# vendored copy here) - same trap, same fix: fixed LF so the pin survives a
# fresh Windows clone (caught by the fresh-clone deploy gate 2026-08-23).
tabletop-completion.js text eol=lf
